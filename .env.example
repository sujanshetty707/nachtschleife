# NACHTSCHLEIFE environment variables
# Copy to .env and fill in. NEVER commit .env.

# Optional: Sketchfab API token for automated GLB download
# Obtain at: https://sketchfab.com/settings/password (API token section)
# Only used by scripts/download_sketchfab.ts for model IDs you explicitly name.
SKETCHFAB_TOKEN=

# Optional: owner details injected at build time
VITE_OWNER_NAME=
VITE_OWNER_ROLE=
VITE_OWNER_GITHUB=
VITE_OWNER_LINKEDIN=
